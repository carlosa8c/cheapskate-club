---
import Layout from "../layouts/Layout.astro";
import { leaderboard } from "../lib/leaderboard";
import { getEngineStats } from "../lib/engine-stats";
import Rankings from "../components/rankings";
import Podium from "../components/podium";

const periodParam = Astro.url.searchParams.get("period");
const period = periodParam === "month" ? "month" : "all";
const tabParam = Astro.url.searchParams.get("tab") === "pairs" ? "pairs" : "builders";

const board = await leaderboard("zero_cost", period);
const stats = await getEngineStats();
---

<Layout
  title="Leaderboard · The Cheapskate Club"
  description="Official all-time and monthly community AI token rankings for cheapoS builders."
>
  <section class="intro leaderboard-intro">
    <div class="eyebrow">
      <span class="little-spark" aria-hidden="true">✳</span>
      OFFICIAL STANDINGS · COMMUNITY COMPUTE
    </div>
    <h1>
      The cheapoS<br />
      <em>Honor Roll.</em>
    </h1>
    <p class="lede">
      Compete for high-mileage glory and coveted thrift titles. Verified machine sync,
      signed token telemetry, maximum compute leverage, and rock-bottom bills.
    </p>
  </section>

  <!-- Top 3 Racing Podium Cards -->
  <Podium client:load entries={board.entries} period={period} />

  <div class="board-layout">
    <Rankings client:load board={board} period={period} modelPairs={stats.modelPairs} initialTab={tabParam} />
    <aside>


      <section class="join-card cheapo-titles-guide-card">
        <div class="eyebrow">HONORARY THRIFT TITLES</div>
        <h3>Cheapo Honorifics</h3>
        <p>
          Climb the ranks to unlock official bragging rights and custom badges:
        </p>
        <ul class="cheapo-titles-list">
          <li><span class="rank-badge">#1</span> 👑 Supreme Frugal Overlord</li>
          <li><span class="rank-badge">#2</span> 🥈 The Discount Baron</li>
          <li><span class="rank-badge">#3</span> 🥉 The Thrifty Wizard</li>
          <li><span class="rank-badge">#4</span> 🏷️ Coupon Clipper Prime</li>
          <li><span class="rank-badge">#5</span> 🍞 Frontier Freeloader</li>
          <li><span class="rank-badge">#6</span> 🔌 Power Strip Parasite</li>
          <li><span class="rank-badge">#7</span> ☕ Free Refill Connoisseur</li>
          <li><span class="rank-badge">#8</span> 📦 Cardboard Box Architect</li>
          <li><span class="rank-badge">#9</span> 🪙 Dime Dropper Deluxe</li>
          <li><span class="rank-badge">#10</span> 🪪 Gate Crasher First Class</li>
        </ul>
        <span class="join-fine">Spots #11–20 feature additional thrift badges.</span>
      </section>

      <section class="small-note">
        <span aria-hidden="true">↳</span>
        <div>
          <h3>Good company. Good ideas.</h3>
          <p>Big side projects. Tiny bills. See how the engine works.</p>
          <a class="inline-link" href="/engine">View engine observatory ↗</a>
        </div>
      </section>
    </aside>
  </div>

  <section class="bottom-banner">
    <span class="banner-star" aria-hidden="true">✳</span>
    <div>
      <h2>Think your tokens belong up here?</h2>
      <p>Sync your local cheapoS installation with the club.</p>
    </div>
    <a class="button" href="/about">
      How it works ↗
    </a>
  </section>
</Layout>
