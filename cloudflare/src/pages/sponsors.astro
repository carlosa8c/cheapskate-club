---
import Layout from "../layouts/Layout.astro";
import { SPONSOR_TIERS, FRUGAL_TOOLS } from "../lib/sponsor-data";
---

<Layout
  title="Sponsor the Club · The Cheapskate Club"
  description="Partner with the Cheapskate Club. Reach autonomous AI builders obsessively optimizing cost per completed task."
>
  <div class="sponsors-page">
    <!-- Hero Section -->
    <section class="intro sponsors-intro">
      <div class="eyebrow">
        <span class="little-spark" aria-hidden="true">✳</span>
        B2B INFRASTRUCTURE & TOOL SPONSORSHIPS
      </div>
      <h1>
        Where builders obsess over<br />
        <em>cost per completed task.</em>
      </h1>
      <p class="lede">
        cheapoS builders don’t read synthetic benchmarks. They run autonomous multi-agent
        coding swarms with API keys in hand, obsessively hunting for the highest intelligence
        at the lowest cost.
      </p>
      <div class="hero-actions" style="margin-top: 24px;">
        <a
          class="button primary"
          href="mailto:sponsors@cheapos.lol?subject=Cheapskate%20Club%20Sponsorship%20Inquiry"
        >
          Email sponsors@cheapos.lol ✉️
        </a>
        <a class="button" href="/engine">
          View live compute telemetry →
        </a>
      </div>
    </section>

    <!-- Telemetry Strip -->
    <section class="sponsors-stats-strip" aria-label="Audience telemetry">
      <div class="sponsor-stat">
        <span class="stat-num">40M+</span>
        <span class="stat-label">Verified Tokens Benchmarked</span>
      </div>
      <div class="sponsor-stat">
        <span class="stat-num">&lt; $0.01</span>
        <span class="stat-label">Average Task Cost Target</span>
      </div>
      <div class="sponsor-stat">
        <span class="stat-num">1-Click</span>
        <span class="stat-label">Local cheapoS CLI Config</span>
      </div>
      <div class="sponsor-stat">
        <span class="stat-num">100%</span>
        <span class="stat-label">Cryptographic Receipt Proofs</span>
      </div>
    </section>

    <!-- The Anti-Cheat Axiom (Trust Callout) -->
    <section class="anti-cheat-section" aria-labelledby="anti-cheat-title">
      <div class="anti-cheat-box">
        <div class="anti-cheat-header">
          <span class="shield-icon" aria-hidden="true">🛡️</span>
          <div>
            <div class="eyebrow-small">OUR PLATFORM ETHICS</div>
            <h2 id="anti-cheat-title">The Anti-Cheat Axiom: Zero Prized Games</h2>
          </div>
        </div>
        <div class="anti-cheat-body">
          <p>
            <strong>Nothing motivates people to cheat more than money.</strong> The minute a
            platform offers cash prizes, bounties, or paid rank manipulation, adversarial gaming
            explodes: sybil accounts, forged receipts, mock token counters, and synthetic spam.
          </p>
          <p>
            To preserve the Cheapskate Club as the most trustworthy, credible benchmark in AI:
          </p>
          <ul class="anti-cheat-rules">
            <li>
              <strong>Rankings are 100% unbuyable:</strong> No amount of sponsorship money can buy
              a leaderboard spot or alter community attestation scores.
            </li>
            <li>
              <strong>No cash prize pools:</strong> Members compete for pure developer status,
              peer recognition, and unforgeable bragging rights.
            </li>
            <li>
              <strong>Sponsorship value is authentic:</strong> Providers sponsor the club to
              demonstrate legitimate price-performance, distribute developer trial credits, and
              earn verified task receipts from real builders.
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Tier Packages -->
    <section class="sponsors-tiers-section" aria-labelledby="packages-title">
      <div class="section-header">
        <div class="eyebrow">
          <span class="little-spark" aria-hidden="true">💎</span>
          SPONSORSHIP PACKAGES
        </div>
        <h2 id="packages-title">Simple, transparent partnership tiers.</h2>
        <p>
          Zero enterprise sales friction. Book a monthly package and place your technology
          directly into the hands of autonomous agent builders.
        </p>
      </div>

      <div class="tiers-grid">
        {
          SPONSOR_TIERS.map((tier) => (
            <div class:list={["tier-card", { "tier-popular": tier.popular }]}>
              {tier.popular && (
                <div class="tier-badge-ribbon">⭐ MOST POPULAR</div>
              )}
              <div class="tier-eyebrow">{tier.eyebrow}</div>
              <h3 class="tier-name">{tier.name}</h3>
              <div class="tier-price-row">
                <span class="tier-price">{tier.price}</span>
                <span class="tier-period">/ {tier.period}</span>
              </div>
              <p class="tier-desc">{tier.description}</p>
              <hr class="tier-divider" />
              <div class="tier-deliverables-title">WHAT'S INCLUDED:</div>
              <ul class="tier-deliverables">
                {tier.deliverables.map((item) => (
                  <li>
                    <span class="check" aria-hidden="true">✓</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
              <div class="tier-cta-wrap">
                <a
                  href={tier.ctaHref}
                  class:list={[
                    "button",
                    tier.popular ? "primary" : "secondary",
                    "tier-btn",
                  ]}
                >
                  {tier.ctaText} ↗
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- The Frugal Stack Directory Preview -->
    <section class="frugal-stack-section" aria-labelledby="tools-title">
      <div class="section-header">
        <div class="eyebrow">
          <span class="little-spark" aria-hidden="true">🛠️</span>
          THE FRUGAL STACK DIRECTORY
        </div>
        <h2 id="tools-title">Curated infrastructure for high-efficiency builders.</h2>
        <p>
          These are the budget-conscious APIs, hosting platforms, and databases that make
          low-cost agent workflows possible.
        </p>
      </div>

      <div class="frugal-tools-grid">
        {
          FRUGAL_TOOLS.map((tool) => (
            <div class="frugal-tool-card">
              <div class="tool-top">
                <span class="tool-category-badge">{tool.category}</span>
                {tool.badge && (
                  <span class="tool-highlight-badge">{tool.badge}</span>
                )}
              </div>
              <h3 class="tool-name">{tool.name}</h3>
              <p class="tool-desc">{tool.description}</p>
              <div class="tool-pricing-box">
                <span class="pricing-icon">🏷️</span>
                <span>{tool.pricingHighlight}</span>
              </div>
              <a
                href={tool.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-link tool-link"
              >
                Visit provider ↗
              </a>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Booking / Contact CTA Box -->
    <section class="sponsors-cta-box">
      <span class="banner-star" aria-hidden="true">✳</span>
      <div>
        <h2>Ready to power the next million cheapoS tasks?</h2>
        <p>
          Tell us about your model or tool. We’ll get your config recipe and trial credits
          live on the club within 24 hours.
        </p>
      </div>
      <div style="display: flex; gap: 12px; flex-wrap: wrap;">
        <a
          class="button primary"
          href="mailto:sponsors@cheapos.lol?subject=Cheapskate%20Club%20Sponsorship%20Inquiry"
        >
          Email sponsors@cheapos.lol ✉️
        </a>
        <a
          class="button secondary"
          href="https://x.com/carlosa8c"
          target="_blank"
          rel="noopener noreferrer"
        >
          DM on X (@carlosa8c) ↗
        </a>
      </div>
    </section>
  </div>
</Layout>
