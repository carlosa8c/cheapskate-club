---
import Layout from "../layouts/Layout.astro";
import { builds } from "../lib/builds";
import BuildCard from "../components/build-card.astro";

const pageParam = Astro.url.searchParams.get("page") || "0";
const page = Math.min(10000, Math.max(0, Number.parseInt(pageParam, 10) || 0));
const isQueue = Astro.url.searchParams.get("queue") === "pending";

const feed = await builds({
  page,
  filterStatus: isQueue ? "pending" : "approved",
}).catch(() => ({ items: [], unavailable: true }));
---

<Layout
  title={isQueue ? "Operator Review Queue · The Cheapskate Club" : "Community Workbench · The Cheapskate Club"}
  description="Complete, working software built end-to-end with cheapoS in a single run. Backed by deterministic unit tests, $0.00 compute bills, and public GitHub repositories."
>
  <section class="intro community-intro">
    <p class="eyebrow">{isQueue ? "OPERATOR REVIEW QUEUE" : "SMALL BUDGETS. BIG IDEAS."}</p>
    <h1>
      {isQueue ? (
        <>Pending<br /><em>Submissions.</em></>
      ) : (
        <>Look what<br /><em>we made.</em></>
      )}
    </h1>
    <p class="lede">
      {isQueue
        ? "Review community projects submitted to The Cheapskate Club before publishing to the public workbench."
        : "Complete, working software built end-to-end with cheapoS in a single run. Backed by deterministic unit tests, $0.00 compute bills, and public GitHub repositories."}
    </p>
    <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-top: 24px;">
      {isQueue ? (
        <a class="button primary" href="/community">
          ← Back to live workbench
        </a>
      ) : (
        <>
          <a class="button primary" href="/community/new">
            Share a build ↗
          </a>
          <a class="button" href="/leaderboard">
            Around the club →
          </a>
        </>
      )}
    </div>
  </section>

  <div class="board-heading">
    <h2>{isQueue ? "Queue items awaiting review" : "Around the workbench"}</h2>
    <div style="display: flex; gap: 12px; align-items: baseline;">
      {!isQueue && (
        <a href="/community?queue=pending" style="font-size: var(--text-meta); color: var(--text-secondary); text-decoration: underline;">
          Operator queue ↗
        </a>
      )}
      <span class="eyebrow">{isQueue ? "PENDING APPROVAL" : "LATEST BUILDS"}</span>
    </div>
  </div>

  {feed.unavailable ? (
    <p class="notice" role="status">
      The workbench is getting ready. Please check back shortly.
    </p>
  ) : feed.items.length > 0 ? (
    <div class="build-grid">
      {feed.items.map((b) => (
        <BuildCard build={b} />
      ))}
    </div>
  ) : (
    <div class="empty-state">
      <span aria-hidden="true">{isQueue ? "✓" : "✳"}</span>
      <h3>{isQueue ? "All caught up!" : (page ? "You’ve reached the end." : "Every club starts with a first build.")}</h3>
      <p>{isQueue ? "There are no pending submissions awaiting operator review." : "It doesn’t have to change the world. Show us what you made."}</p>
      <div style="margin-top: 20px;">
        {isQueue ? (
          <a class="button primary" href="/community">
            Return to live workbench →
          </a>
        ) : (
          <a class="button primary" href="/community/new">
            Submit the first build ↗
          </a>
        )}
      </div>
    </div>
  )}

  <nav class="build-pagination" aria-label="Build pages">
    {page > 0 && <a href={`/community?${isQueue ? "queue=pending&" : ""}page=${page - 1}`}>← Newer builds</a>}
    {feed.items.length === 12 && <a href={`/community?${isQueue ? "queue=pending&" : ""}page=${page + 1}`}>Older builds →</a>}
  </nav>
</Layout>
