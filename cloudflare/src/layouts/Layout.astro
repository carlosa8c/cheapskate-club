---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "The Cheapskate Club · cheapoS",
  description = "Autonomous coding with zero subscription tax. Real software built end-to-end for $0.00.",
} = Astro.props;

const currentPath = Astro.url.pathname;
const canonicalUrl = Astro.url.href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/brand-icon.svg" />

    <!-- Open Graph / Facebook / LinkedIn / Discord -->
    <meta property="og:site_name" content="The Cheapskate Club · cheapoS" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://cheapos.lol/brand-icon.svg" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@cheapos_lol" />
    <meta name="twitter:creator" content="@cheapos_lol" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://cheapos.lol/brand-icon.svg" />

    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("theme");
          if (
            t === "dark" ||
            (!t && window.matchMedia("(prefers-color-scheme:dark)").matches)
          ) {
            document.documentElement.setAttribute("data-theme", "dark");
          } else {
            document.documentElement.setAttribute("data-theme", "light");
          }
        } catch (e) {}
      })();
    </script>
    <style is:global>
      @import "../styles/globals.css";
      @import "../styles/club.css";
      @import "../styles/sponsor-vault.css";
      @import "../styles/quickstart.css";
    </style>
  </head>
  <body data-design="club">
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/">
        <img src="/brand-icon.svg" width="38" height="38" alt="" />
        cheapoS <span>THE CHEAPSKATE CLUB</span>
      </a>
      <nav aria-label="Main navigation">
        <div class="nav-links-group">
          <a
            href="/"
            class:list={["nav-link", { active: currentPath === "/" }]}
            aria-current={currentPath === "/" ? "page" : undefined}
          >
            Home
          </a>
          <a
            href="/leaderboard"
            class:list={[
              "nav-link",
              { active: currentPath.startsWith("/leaderboard") },
            ]}
            aria-current={currentPath.startsWith("/leaderboard") ? "page" : undefined}
          >
            Leaderboard
          </a>
          <a
            href="/engine"
            class:list={["nav-link", { active: currentPath.startsWith("/engine") }]}
            aria-current={currentPath.startsWith("/engine") ? "page" : undefined}
          >
            Engine
          </a>
          <a
            href="/community"
            class:list={[
              "nav-link",
              { active: currentPath.startsWith("/community") },
            ]}
            aria-current={currentPath.startsWith("/community") ? "page" : undefined}
          >
            Community
          </a>

          <a
            href="/bounties"
            class:list={[
              "nav-link",
              { active: currentPath.startsWith("/bounties") },
            ]}
            aria-current={currentPath.startsWith("/bounties") ? "page" : undefined}
          >
            Bounties
          </a>

          <a
            href="/about"
            class:list={["nav-link", { active: currentPath.startsWith("/about") }]}
            aria-current={currentPath.startsWith("/about") ? "page" : undefined}
          >
            How it works
          </a>
        </div>
        <div class="nav-actions">
          <a
            href="/@cheaposnumero1"
            class="nav-profile-pill"
            title="View @cheaposnumero1 profile"
          >
            <span class="nav-avatar" aria-hidden="true">C</span>
            <span>My Card</span>
          </a>
          <a
            href="/account"
            class:list={[
              "button",
              "nav-account-btn",
              { active: currentPath.startsWith("/account") },
            ]}
            title="Account & Installation Settings"
          >
            Account ⚙️
          </a>
          <button
            type="button"
            class="theme-toggle"
            id="theme-btn"
            aria-label="Toggle color theme"
          >
            <span class="theme-toggle-icon" id="theme-icon">◐</span>
            <span class="theme-toggle-label" id="theme-label">Theme</span>
          </button>
        </div>
      </nav>
    </header>

    <main class="page" id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div style="display: flex; flex-direction: column; gap: 8px;">
        <a class="brand" href="/">
          <img src="/brand-icon.svg" width="25" height="25" alt="" />
          cheapoS
        </a>
        <span>Make expensive compute the exception. Proudly operated on a $1.80/yr domain.</span>
      </div>
      <div class="footer-links" style="display: flex; gap: 14px; flex-wrap: wrap; align-items: center;">
        <a class="text-button" href="/#quickstart">Get cheapoS</a>
        <a class="text-button" href="/about">How It Works & FAQ</a>
        <a class="text-button" href="/privacy">Privacy</a>
        <a class="text-button" href="/terms">Terms</a>
        <a class="text-button" href="https://github.com/cheapos/CheapoS" target="_blank" rel="noreferrer">GitHub ↗</a>
        <a class="text-button" href="https://x.com/cheapos_lol" target="_blank" rel="noreferrer">X / Twitter ↗</a>
        <a class="text-button" href="/account">Account ⚙️</a>
      </div>
    </footer>

    <script is:inline>
      const btn = document.getElementById("theme-btn");
      if (btn) {
        btn.addEventListener("click", () => {
          const current = document.documentElement.getAttribute("data-theme");
          const next = current === "dark" ? "light" : "dark";
          document.documentElement.setAttribute("data-theme", next);
          try {
            localStorage.setItem("theme", next);
          } catch (e) {}
        });
      }
    </script>
  </body>
</html>
