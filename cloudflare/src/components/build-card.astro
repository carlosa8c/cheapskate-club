---
import type { Build } from "../lib/builds";

interface Props {
  build: Build;
}

const { build } = Astro.props;
---

<article class="build-card">
  <a href={`/@${build.handle}`} class="build-cover" aria-label={`View build by @${build.handle}`}>
    {build.screenshot_url ? (
      <img src={build.screenshot_url} alt={`Screenshot of ${build.title}`} loading="lazy" referrerpolicy="no-referrer" />
    ) : (
      <span aria-hidden="true">✳</span>
    )}
  </a>
  <div class="build-card-body">
    <p class="eyebrow">BUILT WITH A LITTLE INGENUITY</p>
    <h2>
      <a href={build.project_url || `/@${build.handle}`}>{build.title}</a>
    </h2>
    <p class="build-excerpt">{build.description}</p>
    <div class="build-byline">
      <a href={`/@${build.handle}`}>@{build.handle}</a>
      <span>✦ {build.cheers} cheers</span>
    </div>
  </div>
</article>
