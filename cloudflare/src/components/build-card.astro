---
import type { Build } from "../lib/builds";

interface Props {
  build: Build;
}

const { build } = Astro.props;
const targetHref = build.slug ? `/community/${build.slug}` : `/community/${build.id}`;
const benchmark = build.benchmark || build.telemetry?.benchmark;
const cost = benchmark?.dimension1_cost_tokens?.billedCost || build.telemetry?.cost;
const tokens = benchmark?.dimension1_cost_tokens?.totalTokens ?? build.telemetry?.tokens;
const hasTokens = typeof tokens === "number" && Number.isFinite(tokens) && tokens >= 0;
const tokenLabel = hasTokens
  ? new Intl.NumberFormat("en-US", { notation: "compact", maximumFractionDigits: 2 }).format(tokens)
  : "";
const verification = benchmark
  ? benchmark.dimension5_quality?.finalUnitTestScore
  : build.telemetry?.tests;
const testScore = typeof verification === "string"
  ? verification.match(/^\s*(\d+)\s*\/\s*(\d+)(?=\s|$)/)
  : null;
---

<article class="build-card compact-build-card">
  <div class="compact-build-heading">
    {build.screenshot_url && (
      <img class="compact-build-thumbnail" src={build.screenshot_url} alt="" width="48" height="48" loading="lazy" referrerpolicy="no-referrer" />
    )}
    <h2><a href={targetHref}>{build.title}</a></h2>
  </div>

  {(build.hook || build.description) && (
    <p class="build-excerpt">{build.hook || build.description}</p>
  )}

  {(cost || hasTokens || testScore) && (
    <dl class="compact-build-metrics">
      {cost && <div><dt>Cost</dt><dd>{cost}</dd></div>}
      {hasTokens && (
        <div>
          <dt>Tokens</dt>
          <dd title={`${tokens.toLocaleString("en-US")} tokens`}>
            <span aria-hidden="true">{tokenLabel}</span>
            <span class="sr-only">{tokens.toLocaleString("en-US")}</span>
          </dd>
        </div>
      )}
      {testScore && (
        <div>
          <dt>Tests</dt>
          <dd title={verification}>
            <span aria-hidden="true">{testScore[1]}/{testScore[2]}</span>
            <span class="sr-only">{verification}</span>
          </dd>
        </div>
      )}
    </dl>
  )}

  <div class="compact-build-footer">
    {build.profile_public ? (
      <a href={`/@${build.handle}`} class="compact-build-author">@{build.handle}</a>
    ) : (
      <span class="compact-build-author">@{build.handle}</span>
    )}
    <a href={targetHref} class="compact-build-link" aria-label={`View build: ${build.title}`}>View build →</a>
  </div>
</article>

<style>
  .compact-build-card { padding: 20px; display: flex; flex-direction: column; gap: 14px; }
  .compact-build-heading { display: flex; align-items: flex-start; gap: 12px; }
  .compact-build-thumbnail { width: 48px; height: 48px; flex: 0 0 48px; border-radius: 8px; object-fit: cover; background: var(--surface-inset); }
  .compact-build-heading h2 { font: 22px/1.3 var(--serif); margin: 0; min-width: 0; overflow-wrap: anywhere; }
  .compact-build-card .build-excerpt { font: var(--text-body)/1.5 var(--sans); margin: 0; -webkit-line-clamp: 2; }
  .compact-build-metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(70px, 1fr)); gap: 12px; margin: 0; padding: 12px; border-radius: 8px; background: var(--surface-inset); }
  .compact-build-metrics > div { min-width: 0; }
  .compact-build-metrics dt { font: var(--text-meta)/1.4 var(--sans); color: var(--muted); margin-bottom: 4px; }
  .compact-build-metrics dd { font: 600 var(--text-metric)/1.3 var(--sans); font-variant-numeric: tabular-nums; color: var(--ink); margin: 0; overflow-wrap: anywhere; }
  .compact-build-footer { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 8px 12px; margin-top: auto; padding-top: 12px; border-top: 1px solid var(--surface-border); font: var(--text-meta)/1.5 var(--sans); }
  .compact-build-author { color: var(--muted); overflow-wrap: anywhere; min-width: 0; }
  .compact-build-link { color: var(--ink); font-weight: 600; white-space: nowrap; }
  @media (max-width: 620px) { .compact-build-card { padding: 16px; } }
</style>
