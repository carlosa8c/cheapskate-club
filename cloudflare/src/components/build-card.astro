---
import type { Build } from "../lib/builds";

interface Props {
  build: Build;
}

const { build } = Astro.props;
const targetHref = build.slug ? `/community/${build.slug}` : `/community/${build.id}`;
const isShowcase = Boolean(build.telemetry);
---

<article class="build-card">
  <a href={targetHref} class="build-cover" aria-label={`View ${build.title}`}>
    {build.screenshot_url ? (
      <img src={build.screenshot_url} alt={`Screenshot of ${build.title}`} loading="lazy" referrerpolicy="no-referrer" />
    ) : (
      <div class="showcase-card-fallback" style="display: grid; place-items: center; width: 100%; height: 100%; background: linear-gradient(135deg, rgba(209, 102, 71, 0.12), rgba(36, 63, 50, 0.15));">
        <span style="font-size: 56px; color: var(--accent, #d16647);" aria-hidden="true">
          {build.title.slice(0, 2).toUpperCase()}
        </span>
      </div>
    )}
  </a>
  <div class="build-card-body">
    <div style="display: flex; justify-content: space-between; align-items: center; gap: 8px; flex-wrap: wrap;">
      <p class="eyebrow" style="margin: 0; font-size: var(--text-meta);">
        {isShowcase ? "Autonomous build · $0.00 compute" : "Built with a little ingenuity"}
      </p>
      {isShowcase && (
        <span class="pill" style="margin: 0; padding: 2px 8px; border-radius: 12px; background: var(--status-success-bg); color: var(--status-success); font-size: var(--text-meta); font-weight: bold;">
          Verified run
        </span>
      )}
    </div>

    <h2 style="font-size: 22px; line-height: 1.2; margin: 12px 0 8px;">
      <a href={targetHref}>{build.title}</a>
    </h2>

    <p class="build-excerpt" style="font-size: var(--text-body); line-height: 1.5; color: var(--muted); margin-bottom: 16px;">
      {build.hook || build.description}
    </p>

    {isShowcase && build.telemetry && (
      <div class="card-telemetry-strip">
        <span class="telemetry-success">
          💰 $0.00
        </span>
        <span>
          ⚡ {(build.telemetry.tokens / 1_000_000).toFixed(2)}M tok
        </span>
        <span class="telemetry-success">
          🟢 0 Resumes
        </span>
        {build.telemetry.tests && (
          <span>
            🧪 {build.telemetry.tests.split(" ")[0]}
          </span>
        )}
        <span>
          📖 README
        </span>
      </div>
    )}

    <div class="build-byline" style="border-top: 1px solid var(--line); padding-top: 12px; margin-top: 0;">
      {build.profile_public ? (
        <a href={`/@${build.handle}`}>@{build.handle}</a>
      ) : (
        <span>@{build.handle}</span>
      )}
      <span>✦ {build.cheers} cheers</span>
    </div>
  </div>
</article>
